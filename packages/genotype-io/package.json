{
  "name": "@popgen-toolbox/genotype-io",
  "version": "1.0.0",
  "publishConfig": {
    "access": "public"
  },
  "description": "Tools for working with population genetics file formats in JavaScript/TypeScript",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/stschiff/popgen-toolbox.git",
    "directory": "packages/genotype-io"
  },
  "bugs": {
    "url": "https://github.com/stschiff/popgen-toolbox/issues"
  },
  "homepage": "https://github.com/stschiff/popgen-toolbox/tree/main/packages/genotype-io#readme",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "exports": {
    "./plink": {
      "types": "./dist/plink.d.ts",
      "default": "./dist/plink.js"
    },
    "./utils": {
      "types": "./dist/utils.d.ts",
      "default": "./dist/utils.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "build:watch": "tsc --watch",
    "prepack": "npm run build"
  },
  "devDependencies": {
    "typescript": "^7.0.2"
  }
}
